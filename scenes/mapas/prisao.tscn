nome = "Prisão da Igreja do Décimo Dia"
textos = Array[String](["Ossos de um prisioneiro antigo. Entre as costelas, algo brilha em laranja.", "\"No Décimo Dia, os Nove Sóis julgarão os impuros.
Cem serão entregues, para que mil sejam poupados.\"
— Inscrição da Igreja do Décimo Dia", "Restos de um Marcado. Nas paredes, marcas de contagem:
97 ciclos riscados. E um novo, recém-começado."])

