[node name="Esgoto" type="Node2D"]
script = ExtResource("1_mapa")
nome = "Esgotos sob a Catedral"
fundo_batalha = "res://assets/batalha/fundo_esgoto.png"
textos = Array[String](["Restos de um guarda da prisão. Ainda segura uma tocha apagada.", "Rabiscado na pedra: \"Os ratos ficaram grandes depois que jogaram os corpos do Ritual aqui.\"", "Um cadáver roído até o osso. Seja o que for que fez isso, ainda está por perto."])

